# This repository is authored on Windows and executed on Debian 12.
# Without this file, CRLF line endings travel across and break things:
#   - shell scripts fail with "bad interpreter: /bin/bash^M"
#   - rendered configs (sshd_config, dhcpd.conf) can be rejected by their validators
#   - Jinja2 templates emit CRLF into files that must be LF
#
# Everything in this repo is a Unix artefact, so everything is forced to LF.

* text=auto eol=lf

*.yml   text eol=lf
*.yaml  text eol=lf
*.j2    text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
Makefile text eol=lf

# Never touch these
*.png   binary
*.jpg   binary
*.gz    binary
*.pdf   binary
