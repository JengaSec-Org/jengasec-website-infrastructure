# {{ common_managed_banner }}
#
# Shared proxy parameters — included by every location that proxies to Django.
# /etc/nginx/snippets/jengasec-proxy.conf

# ── Headers Django needs ────────────────────────────────────────────────────
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# THE important one.
#
# Django sees a plain HTTP request from nginx and has no other way to know the
# client used HTTPS. Without this header and SECURE_PROXY_SSL_HEADER in
# settings.py, Django treats every request as insecure: request.is_secure() is
# false, secure cookies are not set, and CSRF origin checking rejects every
# login POST.
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Port $server_port;

# ── Upstream keepalive ──────────────────────────────────────────────────────
# Both lines are required for the `keepalive` directive in the upstream block to
# do anything. HTTP/1.0 has no persistent connections, and a "Connection: close"
# header would close each one immediately.
#
# Setting `keepalive` without these is a very common mistake: it looks
# configured, and every request still pays a fresh connection setup.
proxy_http_version 1.1;
proxy_set_header Connection "";

# ── Timeouts ────────────────────────────────────────────────────────────────
# read_timeout must exceed gunicorn's timeout, or nginx gives up first and the
# user sees a 504 while the worker is still doing useful work. The role asserts
# this rather than trusting it.
proxy_connect_timeout {{ nginx_proxy_connect_timeout }}s;
proxy_read_timeout {{ nginx_proxy_read_timeout }}s;
proxy_send_timeout {{ nginx_proxy_send_timeout }}s;

# ── Buffering ───────────────────────────────────────────────────────────────
# On. nginx reads the whole response from gunicorn as fast as the socket
# allows, freeing the worker, then feeds it to the client at whatever speed the
# client manages. With buffering off, one slow client occupies a gunicorn worker
# for the entire download — and there are only {{ gunicorn_workers | default(9) }} of them.
proxy_buffering {{ 'on' if nginx_proxy_buffering else 'off' }};
proxy_buffers {{ nginx_proxy_buffers }};
proxy_buffer_size {{ nginx_proxy_buffer_size }};
proxy_busy_buffers_size {{ nginx_proxy_buffer_size }};

# ── Redirects ───────────────────────────────────────────────────────────────
# Let Django's own Location headers through untouched — it builds absolute URLs
# correctly once it trusts X-Forwarded-Proto.
proxy_redirect off;

# ── Error handling ──────────────────────────────────────────────────────────
# Retry the next backend when one fails mid-request. `non_idempotent` is
# deliberately NOT included: replaying a POST could submit a score twice.
proxy_next_upstream error timeout http_502 http_503 http_504;
proxy_next_upstream_tries 2;
