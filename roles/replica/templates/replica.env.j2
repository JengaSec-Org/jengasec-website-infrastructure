# {{ common_managed_banner }}
#
# Settings for {{ replica_sync_script }}, read by {{ replica_service_name }}.service.
# Holds the Neon owner password and the database VM's admin password: mode
# 0600, root only. systemd EnvironmentFile syntax: KEY=value, no quoting.

# ── Source: Neon (direct endpoint — replication cannot use the pooler) ──────
SRC_HOST={{ replica_source.hostname }}
SRC_PORT={{ replica_source.port | default(5432, true) }}
SRC_DB={{ replica_source.path | regex_replace('^/', '') }}
SRC_USER={{ replica_source.username }}
SRC_PASSWORD={{ replica_source.password }}
SRC_SSLMODE={{ replica_source_sslmode }}

# ── Target: the database VM ─────────────────────────────────────────────────
DST_HOST={{ replica_host }}
DST_PORT={{ replica_port }}
DST_SSLMODE={{ replica_sslmode }}
DST_ADMIN_USER={{ replica_admin_user }}
DST_ADMIN_PASSWORD={{ replica_admin_password }}
DST_ADMIN_DB={{ replica_admin_db }}
DST_DB={{ replica_database }}
DST_OWNER={{ replica_owner }}

# ── Replication ─────────────────────────────────────────────────────────────
PUBLICATION={{ replica_publication }}
SUBSCRIPTION={{ replica_subscription }}
EXCLUDE_TABLES={{ replica_excluded_tables | join(' ') }}
MARKER={{ replica_marker }}
PG_CLIENT_VERSION={{ replica_pg_client_version }}
