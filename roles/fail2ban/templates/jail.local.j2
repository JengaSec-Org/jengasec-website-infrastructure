# {{ common_managed_banner }}
#
# fail2ban jails for {{ inventory_hostname }}.
#
# This is jail.LOCAL, not jail.conf. jail.conf ships with the package and is
# replaced on every upgrade — anything written there is lost the first time
# fail2ban is updated. This file overrides it and survives.

[DEFAULT]

# ── Never ban these ─────────────────────────────────────────────────────────
# THE MOST IMPORTANT LINE IN THE FILE.
#
# Without the LAN here, a mistyped password from a club laptop bans the address
# you administer from — and fail2ban has no idea a competition is running.
ignoreip = {{ fail2ban_ignoreip | join(' ') }}

# ── Timing ──────────────────────────────────────────────────────────────────
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
{% if fail2ban_bantime_increment %}

# Repeat offenders get progressively longer bans, up to {{ (fail2ban_bantime_maxtime / 86400) | int }} days.
# Someone probing five times in an hour is background noise; someone still at it
# on day three is not, and should not get a fresh hour each time.
bantime.increment = true
bantime.factor    = {{ fail2ban_bantime_factor }}
bantime.maxtime   = {{ fail2ban_bantime_maxtime }}
{% endif %}

# ── Log source ──────────────────────────────────────────────────────────────
# systemd, because Debian 12 has no /var/log/auth.log — it is all in the
# journal. A jail pointed at a file that does not exist starts cleanly and never
# matches anything, which is worse than no jail: it looks like it is working.
backend = {{ fail2ban_backend }}

# ── Ban action ──────────────────────────────────────────────────────────────
# UFW, to match the firewall role. The default iptables action alongside UFW
# means two tools writing the same tables, and rules that appear or vanish
# depending on which one reloaded last.
banaction         = {{ fail2ban_banaction }}
banaction_allports = {{ fail2ban_banaction_allports }}
{% if fail2ban_action_email %}

destemail = {{ fail2ban_destemail }}
sender    = {{ fail2ban_sender }}
action    = %(action_mwl)s
{% else %}

# Ban only, no email. A message per scan attempt trains everyone to filter them,
# and then the one that mattered goes unread as well.
action = %(action_)s
{% endif %}

# ─────────────────────────────────────────────────────────────────────────────
# JAILS
# ─────────────────────────────────────────────────────────────────────────────

{% if fail2ban_sshd_enabled %}
[sshd]
# With password authentication disabled by the ssh role, this is not what keeps
# attackers out — key auth is. What it buys is an auth log you can actually
# read, because the constant background scanning stops after three attempts.
#
# It depends on LogLevel VERBOSE in sshd_config, which the ssh role sets.
enabled  = true
port     = {{ ssh_port | default(22) }}
filter   = sshd
maxretry = {{ fail2ban_sshd_maxretry }}
bantime  = {{ fail2ban_sshd_bantime }}
{% endif %}
{% if 'web' in group_names %}

# ── nginx (this host is in the `web` group) ────────────────────────────────
{% if fail2ban_nginx_http_auth_enabled %}

[nginx-http-auth]
# Failed HTTP basic auth.
enabled  = true
port     = http,https
filter   = nginx-http-auth
logpath  = /var/log/nginx/error.log
maxretry = {{ fail2ban_nginx_maxretry }}
{% endif %}
{% if fail2ban_nginx_botsearch_enabled %}

[nginx-botsearch]
# Probes for /wp-admin, /phpmyadmin, /.env and similar. None of these exist on a
# Django application, so a request for one is never a mistake — it is someone
# enumerating, and there is no false-positive risk in banning it.
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 2
{% endif %}
{% if fail2ban_nginx_limit_req_enabled %}

[nginx-limit-req]
# Clients repeatedly tripping nginx's own rate limit. Pairs with the
# rate-limiting zone the nginx role defines on /login/ and /admin/.
enabled  = true
port     = http,https
filter   = nginx-limit-req
logpath  = /var/log/nginx/error.log
maxretry = 10
{% endif %}
{% if fail2ban_django_enabled %}

[django-auth]
# Brute force against the Django login form.
#
# This is the jail that actually matters for JengaSec: it is the one place where
# credentials are genuinely submitted, by judges and team members whose accounts
# control scoring.
#
# It needs Django configured to log authentication failures with the client IP —
# see roles/fail2ban/README.md. Without that the filter matches nothing.
enabled  = true
port     = http,https
filter   = django-auth
logpath  = {{ fail2ban_django_logpath }}
maxretry = {{ fail2ban_django_maxretry }}
bantime  = {{ fail2ban_django_bantime }}
{% endif %}
{% endif %}
{% if fail2ban_postfix_enabled %}

[postfix]
enabled = true
port    = smtp,465,submission
filter  = postfix
{% endif %}

# Jails for services this host does not run are omitted entirely rather than
# written with `enabled = false` — fail2ban refuses to start if a jail names a
# log file that does not exist, so an nginx jail on the database server would
# take the whole service down.
