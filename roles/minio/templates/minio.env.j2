# {{ common_managed_banner }}
#
# MinIO environment — /etc/default/minio
#
# Read by the systemd unit the .deb ships. Contains the root credentials, so
# this file is 0640 root:{{ minio_group }}.

# The directory objects are stored in. A single path means a single disk with no
# redundancy — MinIO's erasure coding needs four or more. Fine here, because the
# `backup` role covers this host, but it is not a resilient object store.
MINIO_VOLUMES="{{ minio_data_dir }}"

# ── Credentials ─────────────────────────────────────────────────────────────
# Root. These reach every bucket and every object, including submissions.
#
# Create per-application access keys with `mc admin user add` rather than
# handing these to Django — a leaked application key can then be revoked
# without rotating everything.
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# ── Listeners ───────────────────────────────────────────────────────────────
# Bound to the private address. The console is a full administrative interface;
# it has no business on 0.0.0.0.
MINIO_OPTS="--address {{ minio_bind }}:{{ minio_api_port }} --console-address {{ minio_bind }}:{{ minio_console_port }}"
{% if minio_tls_enabled %}

# TLS certificates live in {{ minio_config_dir }}/certs as public.crt and
# private.key — MinIO expects exactly those names.
MINIO_CERTS_DIR="{{ minio_config_dir }}/certs"
{% endif %}

# ── Behaviour ───────────────────────────────────────────────────────────────
# No update check. A competition server has no reason to make outbound calls
# nobody asked for, and updates here are manual anyway.
MINIO_UPDATE=off

# Browser console on. Turn it off if only the API is used — it is the largest
# part of the attack surface and the part most worth removing.
MINIO_BROWSER=on

MINIO_REGION_NAME=jengasec
