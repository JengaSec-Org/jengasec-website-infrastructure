# {{ common_managed_banner }}
#
# rsyslog rules for {{ inventory_hostname }}.
# /etc/rsyslog.d/50-jengasec.conf
#
# Validate:  rsyslogd -N1
{% if logging_separate_auth_log %}

# ── Authentication ──────────────────────────────────────────────────────────
# Auth events into their own file as well as the journal.
#
# journalctl already has them, so why a file: it survives journal rotation, it
# can be copied off the host without journalctl, and it is what you hand to
# whoever reviews an incident. `sudo cp auth.log` is a lower bar than teaching
# someone journalctl at 2am.
auth,authpriv.*                 {{ logging_auth_log }}

# Keep them out of syslog as well, so the general log stays readable.
*.*;auth,authpriv.none          -/var/log/syslog
{% endif %}

# ── Application ─────────────────────────────────────────────────────────────
# gunicorn and nginx both identify themselves. The leading - means asynchronous
# writes: rsyslog does not fsync every line, which matters when nginx is logging
# every request.
{% if 'web' in group_names %}
:programname, isequal, "gunicorn"   -{{ app_log_dir | default('/var/log/jengasec') }}/gunicorn.log
& stop
{% endif %}

# ── Kernel ──────────────────────────────────────────────────────────────────
# Includes the "martian source" and blocked-packet entries the `os` role's
# sysctls generate, and auditd's overflow warnings.
kern.*                          -/var/log/kern.log
{% if logging_remote_enabled and logging_remote_host %}

# ── Remote forwarding ───────────────────────────────────────────────────────
# Logs on a compromised host are evidence an attacker can edit. Shipping them
# elsewhere is the only way to have a copy they cannot reach.
{% if logging_remote_queue_enabled %}

# Queue to disk when the collector is unreachable, so a network blip does not
# lose events. Without this rsyslog buffers in memory and discards when full —
# and it fills fastest during exactly the incident you need the logs for.
$ActionQueueType LinkedList
$ActionQueueFileName jengasec_fwd
$ActionQueueMaxDiskSpace {{ logging_remote_queue_max_disk }}
$ActionQueueSaveOnShutdown on
$ActionResumeRetryCount -1
{% endif %}

# {{ '@@' if logging_remote_protocol == 'tcp' else '@' }} = {{ logging_remote_protocol | upper }}.
{% if logging_remote_protocol != 'tcp' %}
# WARNING: UDP silently drops messages under load — which is precisely when the
# log matters. Prefer tcp.
{% endif %}
*.* {{ '@@' if logging_remote_protocol == 'tcp' else '@' }}{{ logging_remote_host }}:{{ logging_remote_port }}
{% endif %}
