# {{ common_managed_banner }}
#
# HAProxy on {{ inventory_hostname }} — dedicated load balancing tier.
#
# This sits in front of several NGINX hosts. nginx does its own balancing across
# gunicorn; this layer balances across nginx. If you only have one web host, you
# do not need this file.
#
# Validated with `haproxy -c -f` before it replaces the live config.

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy

    # The admin socket, used by `show stat` and for draining a backend without
    # a config reload.
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s

    user haproxy
    group haproxy
    daemon

    maxconn {{ loadbalancer_maxconn }}

    # ── TLS ─────────────────────────────────────────────────────────────────
    # Same policy as nginx: TLS 1.2 and 1.3 only.
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log global
    mode http
    option httplog
    option dontlognull

    # Log the true client address rather than this load balancer's.
    option forwardfor

    # ── Timeouts ────────────────────────────────────────────────────────────
    # Each layer must be MORE patient than the one behind it:
    #   haproxy {{ loadbalancer_timeout_server }} > nginx {{ nginx_proxy_read_timeout | default(180) }}s > gunicorn {{ gunicorn_timeout | default(120) }}s
    # Otherwise the outer layer gives up on work still in progress, and the user
    # sees an error for a request that was about to succeed.
    timeout connect {{ loadbalancer_timeout_connect }}
    timeout client {{ loadbalancer_timeout_client }}
    timeout server {{ loadbalancer_timeout_server }}

    # Time allowed to send complete headers. This is the slow-loris defence:
    # without it a client can hold a connection open indefinitely by sending one
    # byte at a time.
    timeout http-request {{ loadbalancer_timeout_http_request }}
    timeout http-keep-alive 10s
    timeout queue 30s

    errorfile 503 /etc/haproxy/errors/503.http
{% if loadbalancer_redirect_http %}

# ═══════════════════════════════════════════════════════════════════════════
# HTTP — redirect
# ═══════════════════════════════════════════════════════════════════════════
frontend http_in
    bind {{ loadbalancer_bind_address }}:{{ loadbalancer_http_port }}
    mode http
    redirect scheme https code 301 unless { ssl_fc }
{% endif %}

# ═══════════════════════════════════════════════════════════════════════════
# HTTPS
# ═══════════════════════════════════════════════════════════════════════════
frontend https_in
    bind {{ loadbalancer_bind_address }}:{{ loadbalancer_https_port }} ssl crt {{ loadbalancer_ssl_certificate }}
    mode http

    # Tells the backend the client used HTTPS. Django's SECURE_PROXY_SSL_HEADER
    # reads this — without it, every login POST is rejected as insecure. nginx
    # sets the same header; this one must not contradict it.
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port %[dst_port]

    # Do not advertise the version.
    http-response del-header Server

    default_backend jengasec_web

# ═══════════════════════════════════════════════════════════════════════════
# BACKEND — the nginx hosts
# ═══════════════════════════════════════════════════════════════════════════
backend jengasec_web
    mode http
    balance {{ loadbalancer_algorithm }}

    # ── Active health checks ────────────────────────────────────────────────
    # The main thing this tier buys over nginx open source, which only has
    # PASSIVE checks — nginx never probes an idle backend, it learns from real
    # requests failing.
    #
    # /healthz/ runs SELECT 1 and returns 200 or 503, so a backend whose
    # database is unreachable is taken out of rotation. Checking / would not:
    # it is a TemplateView touching no database and returns 200 with PostgreSQL
    # completely down.
    option httpchk
    http-check send meth GET uri {{ loadbalancer_health_check_path }} hdr Host {{ nginx_server_name | default('platform.' ~ (jengasec_domain | default('jengasec.local'))) }}
    http-check expect status 200
{% if loadbalancer_sticky_sessions %}

    # ── Session affinity ────────────────────────────────────────────────────
    # A cookie, not source-address hashing.
    #
    # Correct where nginx's ip_hash is not: a cookie identifies a BROWSER, so an
    # entire campus behind one NAT address is still spread across backends.
    #
    # Django keeps sessions in the database, so this is belt and braces today.
    cookie {{ loadbalancer_sticky_cookie }} insert indirect nocache httponly secure
{% endif %}

{% for backend in loadbalancer_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ backend.port | default(443) }} ssl verify none check inter {{ loadbalancer_health_check_interval }} rise {{ loadbalancer_health_check_rise }} fall {{ loadbalancer_health_check_fall }} weight {{ backend.weight | default(100) }}{% if loadbalancer_sticky_sessions %} cookie {{ backend.name }}{% endif %}

{% endfor %}
{% if loadbalancer_stats_enabled %}

# ═══════════════════════════════════════════════════════════════════════════
# STATS
# ═══════════════════════════════════════════════════════════════════════════
# Every backend's health, current sessions, and error counts. Genuinely useful,
# and a complete map of the infrastructure to anyone who reaches it — so it
# binds to the private address only and requires a password.
listen stats
    bind {{ loadbalancer_stats_bind }}:{{ loadbalancer_stats_port }}
    mode http
    stats enable
    stats uri {{ loadbalancer_stats_uri }}
    stats refresh 10s
    stats show-node
{% if loadbalancer_stats_password | length > 0 %}
    stats auth {{ loadbalancer_stats_user }}:{{ loadbalancer_stats_password }}

    # Allows draining a backend from the web interface. Requires the auth above,
    # which is why it is inside this conditional.
    stats admin if TRUE
{% else %}
    # NO PASSWORD SET. The page is readable by anything that can reach
    # {{ loadbalancer_stats_bind }}:{{ loadbalancer_stats_port }}. Set
    # vault_haproxy_stats_password.
{% endif %}
{% endif %}
