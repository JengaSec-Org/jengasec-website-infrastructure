# {{ common_managed_banner }}
#
# Alert rules for JengaSec.
# Validated with `promtool check rules` before this file is put in place.
#
# Every rule has a `for:` clause. Without one, a single scrape blip fires an
# alert — and an alert that cries wolf is worse than no alert, because everyone
# learns to ignore the channel it arrives on.

groups:
  - name: jengasec-host
    rules:

      # ── Host down ───────────────────────────────────────────────────────
      # The most important rule here. `up` is synthetic: Prometheus sets it to 0
      # when a scrape fails, so this catches a dead host, a dead exporter, and a
      # firewall change equally.
      - alert: HostDown
        expr: up{job="node"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} is not responding"
          description: >-
            Prometheus has failed to scrape {{ '{{ $labels.instance }}' }} for
            2 minutes. The host is down, node_exporter has stopped, or the
            firewall rule allowing this host was changed.

      # ── Disk ────────────────────────────────────────────────────────────
      # Filtered to real filesystems: without the fstype exclusion this fires
      # constantly on tmpfs and overlay mounts that are full by design.
      - alert: DiskSpaceLow
        expr: >-
          100 - ((node_filesystem_avail_bytes{fstype!~"tmpfs|fuse.lxcfs|squashfs|overlay"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|fuse.lxcfs|squashfs|overlay"}) * 100)
          > {{ prometheus_alert_disk_percent }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} disk above {{ prometheus_alert_disk_percent }}%"
          description: >-
            {{ '{{ $labels.mountpoint }}' }} on {{ '{{ $labels.instance }}' }} is
            {{ '{{ printf "%.1f" $value }}' }}% full. On server3 this also holds
            every backup. Common causes: the journal, /var/log, or PostgreSQL WAL
            that nothing is draining.

      # Predicts exhaustion rather than reporting it. Four hours is enough
      # warning to act during an event; a threshold alone would tell you at 85%
      # whether that took a month or an hour.
      - alert: DiskFillingFast
        expr: >-
          predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|fuse.lxcfs|squashfs|overlay"}[1h], 4 * 3600) < 0
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} will run out of disk within 4 hours"
          description: >-
            {{ '{{ $labels.mountpoint }}' }} is filling fast enough to be full
            within four hours at the current rate.

      # ── Memory ──────────────────────────────────────────────────────────
      # MemAvailable, not MemFree: Linux uses free memory for cache, so MemFree
      # is near zero on a healthy server and alerting on it means alerting
      # always.
      - alert: MemoryHigh
        expr: >-
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100
          > {{ prometheus_alert_memory_percent }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} memory above {{ prometheus_alert_memory_percent }}%"
          description: >-
            {{ '{{ printf "%.1f" $value }}' }}% of memory in use. On the 4 GB
            database host this usually means PostgreSQL and Redis together have
            outgrown their configured limits.

      - alert: SwapActive
        expr: >-
          (node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes)
          / node_memory_SwapTotal_bytes > 0.5
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} is swapping heavily"
          description: >-
            Over half of swap is in use. Swap exists as insurance, not as a
            working state — if PostgreSQL's shared buffers are being swapped,
            query latency collapses.

      # ── Load ────────────────────────────────────────────────────────────
      # Compared against the host's own core count, so one rule works on both
      # the 8 GB and 4 GB machines.
      - alert: LoadHigh
        expr: >-
          node_load15 / count without (cpu, mode) (node_cpu_seconds_total{mode="idle"})
          > {{ prometheus_alert_load_multiplier }}
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} load is {{ prometheus_alert_load_multiplier }}x core count"
          description: >-
            15-minute load average is {{ '{{ printf "%.2f" $value }}' }}x the
            number of cores.

  - name: jengasec-services
    rules:

      # ── Service down ────────────────────────────────────────────────────
      # Needs the systemd collector, which node-exporter-defaults enables. This
      # is what turns "the service is down" into an alert rather than a
      # discovery an hour later.
      - alert: ServiceDown
        expr: >-
          node_systemd_unit_state{state="active",
          name=~"(nginx|gunicorn|postgresql|redis-server|named|fail2ban|auditd).service"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.name }}' }} is not active on {{ '{{ $labels.instance }}' }}"
          description: >-
            The unit has not been active for 3 minutes.
            journalctl -u {{ '{{ $labels.name }}' }} -n 50

      - alert: ServiceFlapping
        expr: >-
          changes(node_systemd_unit_state{state="active",
          name=~"(nginx|gunicorn|postgresql|redis-server).service"}[15m]) > 4
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.name }}' }} is restarting repeatedly"
          description: >-
            More than four state changes in 15 minutes. A crash loop looks like
            "up" to anything that only checks once.

  - name: jengasec-certificates
    rules:

      # ── Certificate expiry ──────────────────────────────────────────────
      # Requires the blackbox exporter or a textfile collector, neither of which
      # is deployed yet — so this rule cannot fire today. It is written now so
      # the alert exists the moment the metric does.
      #
      # Until then, the `cron` role checks expiry daily and mails the result.
      - alert: CertificateExpiringSoon
        expr: >-
          probe_ssl_earliest_cert_expiry - time() < {{ prometheus_alert_cert_expiry_days }} * 86400
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expires within {{ prometheus_alert_cert_expiry_days }} days"
          description: >-
            {{ '{{ $labels.instance }}' }} presents a certificate expiring in
            {{ '{{ printf "%.0f" $value }}' }} seconds. Internal CA certificates
            are renewed by re-running the certificates role.
