# {{ common_managed_banner }}
#
# Environment for the JengaSec platform on {{ inventory_hostname }}.
#
# Read by systemd as EnvironmentFile= for the gunicorn unit, and by
# config/settings.py through os.environ.
#
# EVERY NAME HERE MATCHES config/settings.py EXACTLY. Renaming one does not
# raise an error — Django simply falls back to its default. For
# JENGASEC_DB_NAME that fallback is SQLite, which means production quietly
# running on a file no backup covers.
#
# Contains the secret key, database credentials and API keys. Mode 0640,
# owned by {{ django_user }}.
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell quoting.
# The django role parses this same file to run manage.py, so one KEY=value per
# line and nothing cleverer.

# ── Core ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY={{ vault_django_secret_key }}
DJANGO_DEBUG={{ 'True' if django_debug else 'False' }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts | join(',') }}
DJANGO_SETTINGS_MODULE={{ django_settings_module }}

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Django sees plain HTTP from nginx. Without the origins below it rejects every
# login POST with a CSRF failure whose message does not mention the cause.
# Entries must include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS={{ django_csrf_trusted_origins | join(',') }}

# HSTS is set by nginx. 0 here so one policy has one owner.
DJANGO_HSTS_SECONDS={{ django_hsts_seconds }}

# ── Database ────────────────────────────────────────────────────────────────
{% if django_db_url %}
# A hosted database, shared with the Render instance. The URL carries host,
# user, password, database and TLS mode, and settings.py prefers it over any
# JENGASEC_DB_* value — so none are written, leaving one source of truth.
JENGASEC_DB_URL={{ django_db_url }}
{% else %}
# Setting JENGASEC_DB_NAME is what switches settings.py off SQLite. Always
# present for that reason.
JENGASEC_DB_NAME={{ django_db_name }}
JENGASEC_DB_USER={{ django_db_user }}
JENGASEC_DB_PASSWORD={{ django_db_password }}
JENGASEC_DB_HOST={{ django_db_host }}
JENGASEC_DB_PORT={{ django_db_port }}

# 'prefer' encrypts when the server offers it but does not verify the
# certificate. Move to 'verify-full' once the internal CA is in the trust store
# on this host — the `certificates` role puts it there.
JENGASEC_DB_SSLMODE={{ django_db_sslmode }}
{% endif %}

# ── Uploads ─────────────────────────────────────────────────────────────────
{% if django_s3_bucket %}
# Object storage. Uploads go to the bucket and are served through signed URLs
# that expire after an hour; the local media directory is unused.
S3_BUCKET={{ django_s3_bucket }}
S3_ENDPOINT_URL={{ django_s3_endpoint_url }}
S3_REGION={{ django_s3_region }}
S3_ACCESS_KEY_ID={{ django_s3_access_key_id }}
S3_SECRET_ACCESS_KEY={{ django_s3_secret_access_key }}
{% else %}
# Local disk, read by nginx through group membership.
DJANGO_MEDIA_ROOT={{ django_media_dir }}
{% endif %}

# ── Email ───────────────────────────────────────────────────────────────────
# With BREVO_API_KEY set and no DJANGO_EMAIL_BACKEND, settings.py sends through
# Brevo over HTTPS. An explicit backend always wins.
{% if django_email_backend %}
DJANGO_EMAIL_BACKEND={{ django_email_backend }}
{% endif %}
{% if django_brevo_api_key %}
BREVO_API_KEY={{ django_brevo_api_key }}
{% endif %}
DJANGO_EMAIL_HOST={{ django_smtp_host }}
DJANGO_EMAIL_PORT={{ django_smtp_port }}
DJANGO_EMAIL_HOST_USER={{ django_smtp_user }}
DJANGO_EMAIL_HOST_PASSWORD={{ django_smtp_password }}
DJANGO_EMAIL_USE_TLS={{ 'True' if django_smtp_use_tls else 'False' }}
{% if django_default_from_email %}
DJANGO_DEFAULT_FROM_EMAIL={{ django_default_from_email }}
{% endif %}

# Absolute base for links inside emails. The public address even on the venue
# instance — emails are opened from anywhere.
DJANGO_SITE_URL={{ django_site_url }}

# ── Sessions and cookies ────────────────────────────────────────────────────
{% if django_session_cookie_age | string | length > 0 %}
DJANGO_SESSION_COOKIE_AGE={{ django_session_cookie_age }}
{% endif %}
{% if django_insecure_cookies | bool %}
# VENUE ONLY. Session and CSRF cookies travel over plain HTTP so sign-in works
# before TLS exists. Remove the moment the certificate is in place.
DJANGO_INSECURE_COOKIES=True
{% endif %}

# ── Shared secrets ──────────────────────────────────────────────────────────
{% if django_token_key %}
DJANGO_TOKEN_KEY={{ django_token_key }}
{% endif %}
{% if django_deploy_token %}
DJANGO_DEPLOY_TOKEN={{ django_deploy_token }}
{% endif %}
{% if django_cron_token %}
# This instance runs the reminder jobs. No other instance sharing the
# database may hold this token, or every reminder goes out twice.
DJANGO_CRON_TOKEN={{ django_cron_token }}
{% endif %}
{% if django_portal_api_url %}

# ── Range portal API ────────────────────────────────────────────────────────
# Called server-side only. The token can revoke anyone's VPN access; it never
# reaches a template or a browser. Names are provisional until confirmed
# against services/portal_client.py.
PORTAL_API_URL={{ django_portal_api_url }}
{% if django_portal_admin_token %}
PORTAL_ADMIN_TOKEN={{ django_portal_admin_token }}
{% endif %}
{% endif %}

# ── AI evaluation ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL={{ django_ollama_base_url }}
OLLAMA_MODEL={{ django_ollama_model }}
{% if django_redis_enabled %}

# ── Redis ───────────────────────────────────────────────────────────────────
# settings.py does not read these yet. Written so the infrastructure is ready
# when caching or Celery is wired up.
REDIS_HOST={{ django_redis_host }}
REDIS_PORT={{ django_redis_port }}
{% if django_redis_password %}
REDIS_PASSWORD={{ django_redis_password }}
REDIS_URL=redis://:{{ django_redis_password }}@{{ django_redis_host }}:{{ django_redis_port }}/0
{% else %}
REDIS_URL=redis://{{ django_redis_host }}:{{ django_redis_port }}/0
{% endif %}
{% endif %}

# ── Python ──────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
