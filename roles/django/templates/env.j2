# {{ common_managed_banner }}
#
# Environment for the JengaSec platform on {{ inventory_hostname }}.
#
# Read by systemd as EnvironmentFile= for the gunicorn unit, and by
# config/settings.py through os.environ.
#
# EVERY NAME HERE MATCHES config/settings.py EXACTLY. Renaming one does not
# raise an error — Django simply falls back to its default. For
# JENGASEC_DB_NAME that fallback is SQLite, which means production quietly
# running on a file no backup covers.
#
# Contains the secret key and the database password. Mode 0640, owned by
# {{ django_user }}.
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell quoting.

# ── Core ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY={{ vault_django_secret_key }}
DJANGO_DEBUG={{ 'True' if django_debug else 'False' }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts | join(',') }}
DJANGO_SETTINGS_MODULE={{ django_settings_module }}

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Django sees plain HTTP from nginx. Without the origins below it rejects every
# login POST with a CSRF failure whose message does not mention the cause.
# Entries must include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS={{ django_csrf_trusted_origins | join(',') }}

# HSTS is set by nginx. 0 here so one policy has one owner.
DJANGO_HSTS_SECONDS={{ django_hsts_seconds }}

# ── Database ────────────────────────────────────────────────────────────────
# Setting JENGASEC_DB_NAME is what switches settings.py off SQLite. Always
# present for that reason.
JENGASEC_DB_NAME={{ django_db_name }}
JENGASEC_DB_USER={{ django_db_user }}
JENGASEC_DB_PASSWORD={{ django_db_password }}
JENGASEC_DB_HOST={{ django_db_host }}
JENGASEC_DB_PORT={{ django_db_port }}

# 'prefer' encrypts when the server offers it but does not verify the
# certificate. Move to 'verify-full' once the internal CA is in the trust store
# on this host — the `certificates` role puts it there.
JENGASEC_DB_SSLMODE={{ django_db_sslmode }}

# ── Email ───────────────────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND={{ django_email_backend }}
EMAIL_HOST={{ django_smtp_host }}
EMAIL_PORT={{ django_smtp_port }}
EMAIL_HOST_USER={{ django_smtp_user }}
EMAIL_HOST_PASSWORD={{ django_smtp_password }}
EMAIL_USE_TLS={{ 'True' if django_smtp_use_tls else 'False' }}

# ── AI evaluation ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL={{ django_ollama_base_url }}
OLLAMA_MODEL={{ django_ollama_model }}
{% if django_redis_enabled %}

# ── Redis ───────────────────────────────────────────────────────────────────
# settings.py does not read these yet. Written so the infrastructure is ready
# when caching or Celery is wired up.
REDIS_HOST={{ django_redis_host }}
REDIS_PORT={{ django_redis_port }}
{% if django_redis_password %}
REDIS_PASSWORD={{ django_redis_password }}
REDIS_URL=redis://:{{ django_redis_password }}@{{ django_redis_host }}:{{ django_redis_port }}/0
{% else %}
REDIS_URL=redis://{{ django_redis_host }}:{{ django_redis_port }}/0
{% endif %}
{% endif %}

# ── Python ──────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
