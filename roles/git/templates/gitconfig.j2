# {{ common_managed_banner }}
#
# System-wide git configuration — /etc/gitconfig
#
# Applies to every user on this host. Individual users can still override any of
# it in ~/.gitconfig; this is a floor, not a ceiling.

{% set sections = {} %}
{% for key, value in git_config | dictsort %}
{%   set section = key.split('.')[0] %}
{%   set option = key.split('.')[1:] | join('.') %}
{%   if sections.update({section: sections.get(section, []) + [(option, value)]}) %}{% endif %}
{% endfor %}
{% for section, options in sections | dictsort %}
[{{ section }}]
{%   for option, value in options %}
	{{ option }} = {{ value }}
{%   endfor %}

{% endfor %}
{% if git_safe_directories %}
# Git refuses to operate on a repository owned by a different user
# (CVE-2022-24765 — a repository in a shared directory could otherwise run
# hooks as whoever ran the git command). The application checkout is owned by
# the app user but inspected by admins over sudo, so it is declared safe here
# rather than disabling the protection globally with safe.directory = *.
[safe]
{% for directory in git_safe_directories %}
	directory = {{ directory }}
{% endfor %}
{% endif %}
