---
# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE — every secret this repository needs, with placeholder values.
#
#   cp vault.yml.example vault.yml
#   # edit vault.yml with real values
#   ansible-vault encrypt vault.yml
#
# vault.yml is gitignored. THIS file is committed and must never contain a real
# secret. Full workflow in docs/secrets.md.
#
# Convention: every key is prefixed vault_ so that a grep for `vault_` in the
# roles shows exactly what is sensitive, and a variable referenced from a task
# is obviously a secret at the call site.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ──────────────────────────────────────────────────────────────────
# Becomes DJANGO_SECRET_KEY. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
vault_django_secret_key: "CHANGE_ME_generate_a_64_character_random_string"

# ── PostgreSQL ──────────────────────────────────────────────────────────────
vault_postgresql_jengasec_password: "CHANGE_ME"
vault_postgresql_replication_password: "CHANGE_ME"   # Phase 6, replication

# ── Redis ───────────────────────────────────────────────────────────────────
vault_redis_password: "CHANGE_ME"

# ── Grafana ─────────────────────────────────────────────────────────────────
vault_grafana_admin_password: "CHANGE_ME"

# ── HAProxy stats page (Phase 6, role disabled by default) ──────────────────
# The stats page shows every backend, its health and its traffic — a complete
# map of the infrastructure. The role warns if this is left empty.
vault_haproxy_stats_password: "CHANGE_ME"

# ── MinIO (Phase 8, role is a stub) ─────────────────────────────────────────
vault_minio_root_password: "CHANGE_ME"

# ── SMTP (Django password-reset and notification email) ────────────────────
vault_smtp_host: "smtp.example.com"
vault_smtp_port: 587
vault_smtp_user: "sucybersec@strathmore.edu"
vault_smtp_password: "CHANGE_ME"

# ── Shared with the Render instance (venue hosting) ─────────────────────────
# ALL OPTIONAL. Leave a key out and the django role writes nothing for it. Set
# them to make this host a second front door onto the same data as
# www.jengasec.com — the platform's docs/VENUE-HOSTING.md. Copy each from
# Render → the service → Environment, and set vault_django_secret_key above to
# Render's DJANGO_SECRET_KEY too, or sessions and stored tokens do not carry
# across.
#
# Neon pooled connection string. When set it replaces the local PostgreSQL.
# vault_jengasec_db_url: "postgresql://neondb_owner:CHANGE_ME@ep-CHANGE_ME-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Backblaze B2 bucket for uploads. Without it, files uploaded on Render are
# missing here and vice versa.
# vault_s3_bucket: "jengasec-submissions"
# vault_s3_endpoint_url: "https://s3.CHANGE_ME.backblazeb2.com"
# vault_s3_region: "CHANGE_ME"
# vault_s3_access_key_id: "CHANGE_ME"
# vault_s3_secret_access_key: "CHANGE_ME"
#
# Brevo API key — email over HTTPS. Selects the Brevo backend.
# vault_brevo_api_key: "xkeysib-CHANGE_ME"
#
# Encrypts blue-team registry tokens. Must match Render's DJANGO_TOKEN_KEY.
# vault_django_token_key: "CHANGE_ME"
#
# Guards /deployments/api/* for the range's deploy agent.
# vault_django_deploy_token: "CHANGE_ME"
#
# Guards POST /api/feed/ for the AI API's marks. Same value as WEBSITE_FEED_TOKEN
# in /etc/jengasec-ai/ai-api.env. Generate: openssl rand -hex 32
# vault_django_feed_token: "CHANGE_ME"
#
# The reminder runner. Leave UNSET while Render holds it — two instances with
# this token send every reminder twice.
# vault_django_cron_token: "CHANGE_ME"

# ── Database VM replica (roles/replica) ─────────────────────────────────────
# A login on 192.168.40.45 that may create databases and subscriptions
# (superuser, or PostgreSQL 16+ CREATEDB + pg_create_subscription). From
# whoever administers that VM.
vault_replica_admin_user: "postgres"
vault_replica_admin_password: "CHANGE_ME"
# Set by the role for jengasec_web, the read-only owner of the copy. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
vault_replica_owner_password: "CHANGE_ME"

# ── Range portal API ────────────────────────────────────────────────────────
# The admin token for the range team's API on this VM (127.0.0.1:8080). It can
# revoke anyone's VPN access. Handed over in person — never sent by chat or
# email, never committed.
# vault_portal_admin_token: "CHANGE_ME"

# ── Local account passwords ─────────────────────────────────────────────────
# Not used in v1. Everyone signs in as netadmin, whose password is set by hand
# on the VM (`sudo passwd netadmin`), not from the vault.
vault_jengasec_password_hash: "$6$CHANGE_ME"

# ── Purchased TLS certificate (Namecheap) ───────────────────────────────────
# Only with nginx_custom_tls_enabled: true. docs/custom-certificate.md.
# The CHAIN: your_domain.crt, then your_domain.ca-bundle, as one block. Keep
# the "|" and indent every line by two spaces.
# vault_custom_tls_fullchain: |
#   -----BEGIN CERTIFICATE-----
#   ...your domain's certificate...
#   -----END CERTIFICATE-----
#   -----BEGIN CERTIFICATE-----
#   ...the CA bundle...
#   -----END CERTIFICATE-----
# The private key generated WITH the CSR — the one secret in this pair.
# vault_custom_tls_key: |
#   -----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----

# ── Internal certificate authority ──────────────────────────────────────────
vault_ca_passphrase: "CHANGE_ME"

# ── Backup encryption ───────────────────────────────────────────────────────
vault_backup_gpg_passphrase: "CHANGE_ME"

# ── Cloudflare ──────────────────────────────────────────────────────────────
# THREE separate values, and the two tokens are NOT interchangeable.
#
# The tunnel token authenticates this host as the tunnel. Anyone holding it can
# serve traffic for your public hostname.
#   Zero Trust > Networks > Tunnels > (your tunnel) > Configure
vault_cloudflare_tunnel_token: "CHANGE_ME"

# A separate API token for managing Access policies. Needs
# "Access: Apps and Policies — Edit". The tunnel token has no Access rights, and
# using one where the other is needed fails with an unhelpful 403.
#   My Profile > API Tokens > Create Token
vault_cloudflare_api_token: "CHANGE_ME"

# Dashboard, right-hand sidebar.
vault_cloudflare_account_id: "CHANGE_ME"
vault_cloudflare_zone_id: "CHANGE_ME"

# ── Tailscale (remote admin access) ─────────────────────────────────────────
# Enrols the host in the organisers' tailnet — equivalent to a device key.
#   https://login.tailscale.com/admin/settings/keys → Generate auth key
#   Reusable OFF · Ephemeral OFF · Pre-approved ON · Tags: tag:jengasec-server
# The tag must exist in the tailnet ACL first (docs/runbook.md §9b).
vault_tailscale_auth_key: "tskey-auth-CHANGE_ME"

# ── DNS ─────────────────────────────────────────────────────────────────────
# rndc key for controlling Bind9. Generate with:  rndc-confgen -a
vault_rndc_key: "CHANGE_ME"
